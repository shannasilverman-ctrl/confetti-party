# Public browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
OPENAI_API_KEY=your-server-only-openai-key

# Optional model override. The default is gpt-5.6-terra.
OPENAI_TEXT_MODEL=gpt-5.6-terra

# Used to create privacy-preserving Realtime safety identifiers.
OPENAI_SAFETY_SALT=replace-with-a-long-random-server-only-value
