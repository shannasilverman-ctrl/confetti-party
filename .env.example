# Public browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
OPENAI_API_KEY=your-server-only-openai-key

# Optional model override. The default is gpt-5.6-terra.
OPENAI_TEXT_MODEL=gpt-5.6-terra

# Used to create privacy-preserving Realtime safety identifiers.
OPENAI_SAFETY_ID_SALT=replace-with-a-long-random-server-only-value

# Optional, staging-only SMS planning transport. Keep every value server-side.
# Do not configure these until the SMS migration has passed the rollback-only
# harness in an isolated Supabase project.
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-with-a-server-only-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=MG00000000000000000000000000000000
TWILIO_SMS_WEBHOOK_URL=https://sms-staging.example.com/api/sms/inbound
TWILIO_SMS_TO_NUMBER=+12025550123
SMS_LOOKUP_SECRET=replace-with-at-least-32-random-characters
# Base64 for exactly 32 random bytes. The id is embedded in ciphertext so old
# keys can be retained during a deliberate rotation.
SMS_ENCRYPTION_KEY=replace-with-base64-for-32-random-bytes
SMS_ENCRYPTION_KEY_ID=staging-2026-07
